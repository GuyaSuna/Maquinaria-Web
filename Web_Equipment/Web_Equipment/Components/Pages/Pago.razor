@page "/equipos/{EquipmentId}/pago"
@rendermode InteractiveServer

@using Web_Equipment.Models
@using Web_Equipment.Services

@inject PagoApiService PagoService
@inject NavigationManager Navigation

<h3>Pago de revisión de equipamiento</h3>

<p>Equipamiento: @EquipmentId</p>

@if (cargando)
{
    <p>Cargando pagos...</p>
}
else
{
    <div class="card p-3 mb-3">

        <h5>Revisión técnica</h5>

        <p>Importe: $850 UYU</p>

        <button class="btn btn-primary"
                disabled="@procesando"
                @onclick="IniciarPago">

            @(procesando ? "Procesando..." : "Pagar con Mercado Pago")

        </button>
    </div>

    <h4>Historial de pagos</h4>

    @if (pagos.Count == 0)
    {
        <p>No existen pagos registrados.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Importe</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var pago in pagos)
                {
                    <tr>
                        <td>@pago.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>$@pago.Monto</td>

                        <td>
                            <span class="@ObtenerClaseEstado(pago.Estado)">
                                @pago.Estado
                            </span>
                        </td>

                        <td>
                            <button class="btn btn-outline-primary btn-sm"
                                    disabled="@procesando"
                                    @onclick="() => ConsultarEstado(pago.Id)">
                                Consultar estado
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <p class="mt-3">@mensaje</p>
}

@code {
    [Parameter]
    public string EquipmentId { get; set; } = "";

    private List<PagoRevision> pagos = new();

    private bool cargando = true;
    private bool procesando = false;
    private string mensaje = "";

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        try
        {
            pagos = await PagoService.ObtenerPagosAsync(EquipmentId);
            mensaje = "";
        }
        catch (Exception)
        {
            pagos = new();
            mensaje = "No se pudieron cargar los pagos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task IniciarPago()
    {
        procesando = true;
        mensaje = "";

        try
        {
            var url = await PagoService.CrearPagoAsync(EquipmentId);

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception)
        {
            mensaje = "No se pudo iniciar el pago.";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task ConsultarEstado(int pagoId)
    {
        procesando = true;
        mensaje = "";

        try
        {
            await PagoService.ActualizarEstadoAsync(pagoId);

            pagos = await PagoService.ObtenerPagosAsync(EquipmentId);

            mensaje = "Estado consultado correctamente.";
        }
        catch (Exception)
        {
            mensaje = "No se pudo consultar el estado del pago.";
        }
        finally
        {
            procesando = false;
        }
    }

    private string ObtenerClaseEstado(string estado)
    {
        return estado.ToUpper() switch
        {
            "PAGADO" => "badge bg-success",
            "RECHAZADO" => "badge bg-danger",
            "PENDIENTE" => "badge bg-warning text-dark",
            _ => "badge bg-secondary"
        };
    }
}
